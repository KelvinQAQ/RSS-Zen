[Unit]
Description=RSS-Zen bounded Feishu delivery worker
After=network-online.target rss-zen.service
Wants=network-online.target

[Service]
Type=oneshot
User=rss-zen
Group=rss-zen
WorkingDirectory=/var/lib/rss-zen
LoadCredential=rss-zen.env:/etc/rss-zen/rss-zen.env
EnvironmentFile=%d/rss-zen.env
ExecStart=/opt/rss-zen/current/.venv/bin/rss-zen delivery-run --json --config /etc/rss-zen/rss-zen.toml
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rss-zen
