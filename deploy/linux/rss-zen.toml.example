# Generated as /etc/rss-zen/rss-zen.toml by scripts/deploy-linux.sh.
# Replace every replace-me value before services can start.

[database]
path = "/var/lib/rss-zen/rss-zen.sqlite3"

[service]
default_poll_interval_minutes = 30
translation_retry_interval_minutes = 5
translation_max_attempts = 5
retry_max_backoff_minutes = 360

[limits]
max_feed_response_bytes = 10000000
max_entries_per_feed = 500
max_article_chars = 500000
max_translation_chars = 100000
max_provider_requests_per_run = 200
max_source_chars_per_run = 500000
max_extract_articles_per_run = 20
max_translate_articles_per_run = 50

[backup]
directory = "/var/lib/rss-zen/backups"
retention_days = 30
retention_count = 30

# Data deletion is disabled by default. Uncomment and choose periods only after
# running `rss-zen retention --dry-run` against production data.
# [retention]
# articles_days = 365
# failed_extractions_days = 30
# export_runs_days = 90
# batch_runs_days = 30

[translation]
target_language = "zh-CN"

[[translation.providers]]
name = "replace-me-provider"
kind = "openai_compatible"
endpoint = "https://replace-me.invalid/v1"
api_key_env = "AI_TRANSLATION_API_KEY"
model = "replace-me-model"

[anysearch]
base_url = "https://api.anysearch.com"
tag = "general.general"
zone = "intl"
language = "zh-CN"
max_results = 3

# Keep disabled until the custom app permissions, target chat, and staging send are approved.
[feishu]
enabled = false
app_id_env = "FEISHU_APP_ID"
app_secret_env = "FEISHU_APP_SECRET"
# target_ref = "chat:oc_approved"
batch_size = 10
max_attempts = 5
lease_minutes = 5
max_backoff_minutes = 60
budget_mode = "observe"

# Add one or more HTTPS feeds after completing provider configuration.
# [[feeds]]
# name = "Example feed"
# url = "https://feeds.example.com/rss.xml"
# categories = ["technology"]
# poll_interval_minutes = 30
# language = "en"

[[exports]]
name = "daily"
output_path = "/var/lib/rss-zen/exports/daily.md"
title = "Daily reading"
fields = ["source_name", "published_at", "url", "content"]
content_fallback = ["full_text", "rss_content", "summary"]

[exports.filters]
translation_status = "succeeded"

[[exports.preprocess]]
field = "content"
operation = "strip_html"
