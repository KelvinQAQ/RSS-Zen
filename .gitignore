# Virtual environments
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage/
htmlcov/

# Local test and tooling state
.test-tmp/
.codewhale/
# Runtime project-development tracking data. The skill implementation is tracked
# under .pi/skills/, but state/events/reports/backups are always local only.
.pi/project-management/
*.sqlite3
*.sqlite3-*
# uv.lock IS committed (reproducible builds)
!uv.lock

# Archives (the original distribution archive must not be committed)
*.rar
*.zip
*.tar.gz

# Local configuration (contains real credentials/URLs once filled in)
rss-zen.yaml
rss-zen.yml
rss-zen.toml
rss-zen.toml.enc
*.env
.env.*

# Generated output
exports/

# Live end-to-end artifacts
.e2e/

# Build artifacts
dist/
build/
*.egg-info/

# Editor/OS noise
.DS_Store
*.swp

# Personal data / live endpoints — commit only if intended
rsstranslator_original_feeds.opml
e2e.rss-zen.toml
